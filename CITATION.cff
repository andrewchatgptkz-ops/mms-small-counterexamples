keywords:
  - fair division
  - maximin share
  - MMS
  - indivisible goods
  - counterexample
references:
  - type: article
    title: "On Lower Bounds for Maximin Share Guarantees"
    authors:
      - family-names: Hummel
        given-names: Halvard
    year: 2023
    notes: "IJCAI 2023; arXiv:2302.00264. Gives an MMS allocation whenever m <= n + 6 for n != 3, hence m <= 10 for four agents."
  - type: conference-paper
    title: "A tight negative example for MMS fair allocations"
    authors:
      - family-names: Feige
        given-names: Uriel
      - family-names: Sapir
        given-names: Ariel
      - family-names: Tauber
        given-names: Laliv
    year: 2021
    notes: "WINE 2021; arXiv:2104.04977. Theorem 14 (strengthening Theorem 4) gives, for four agents, a 13-good instance with MMS 68 in which some agent gets at most 67."
